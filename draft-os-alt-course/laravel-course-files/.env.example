# Заглушка «Портал обновляется» для обучающихся (не portal_staff). По умолчанию выключена.
PORTAL_USER_MAINTENANCE=false

# --- OIDC / ADFS (опционально; пока false — вход только по почте на /login) ---
OIDC_ENABLED=false
OIDC_REQUIRED=false
OIDC_DISCOVERY_URL=https://fs.croc.ru/adfs/.well-known/openid-configuration
OIDC_ISSUER=https://fs.croc.ru/adfs
OIDC_CLIENT_ID=0f9cb2e1-ad40-4453-b55e-f2458c92682e
# Секрет клиента — только на сервере в .env, не коммитить:
OIDC_CLIENT_SECRET=
OIDC_SCOPE="openid profile email"
OIDC_REDIRECT_HOSTS=172.26.76.216,practice.croc.ru
OIDC_REDIRECT_URI=https://practice.croc.ru/oidc/callback
# Кнопка «Войти через SSO»: forms — сразу фирменная веб-форма ADFS (prompt=login, по умолчанию);
# silent — сначала тихая попытка prompt=none (на ADFS Croc уводит на WIA-попап — включать
# только после починки WIA/Kerberos на стороне ADFS).
OIDC_BUTTON_MODE=forms
# Фоновый тихий вход: гость уводится на IdP ещё до клика по кнопке (та же оговорка про WIA)
OIDC_SILENT_LOGIN=false
# На сколько минут запоминается неудачная тихая попытка (защита от цикла редиректов)
OIDC_SILENT_PROBE_MINUTES=720
# Тихий вход не пытается подняться столько минут после явного выхода из портала
OIDC_SILENT_LOGOUT_MINUTES=5
# Вход под другой учётной записью (prompt=login). false — только текущая доменная УЗ
OIDC_ALLOW_REAUTH=false
# Если redirect_uri только на practice, а заходят с IP — портал перенаправит на https://practice.croc.ru/oidc/login
# OIDC_PUBLIC_ORIGIN=https://practice.croc.ru

# --- Почта портала (Exchange EWS по HTTPS) ---
PORTAL_MAIL_ENABLED=true
PORTAL_MAIL_EWS_URL=https://owa.croc.ru/EWS/Exchange.asmx
PORTAL_MAIL_USERNAME=practice@croc.ru
PORTAL_MAIL_PASSWORD=
PORTAL_MAIL_FROM_ADDRESS=practice@croc.ru
PORTAL_MAIL_FROM_NAME="Учебный портал practice.croc.ru"
PORTAL_MAIL_VERIFY_SSL=false
PORTAL_MAIL_TIMEOUT=25
